{
  "name": "stripe-fee-auditor",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components lib scripts tests next.config.ts --max-warnings 0",
    "test": "tsx tests/test-algorithm.ts && tsx tests/test-integration.ts && tsx tests/test-preview-gate.ts && tsx tests/test-time-since-load.ts && tsx tests/security-input.ts && tsx tests/security-monitor-session.ts && node tests/i18n-integrity.mjs && node tests/seo-cluster-integrity.mjs",
    "validate:seo": "node scripts/seo-validate.mjs",
    "i18n:pages:extract": "node scripts/extract-pages-en.mjs",
    "i18n:pages:translate": "python scripts/translate-pages-locales.py",
    "i18n:pages:sync": "node scripts/restructure-locale-pages.mjs",
    "check:prod": "node scripts/check-production.mjs",
    "check:health": "node scripts/check-health.mjs",
    "check:post-beta": "node scripts/check-post-beta-smoke.mjs",
    "seed:stripe-test": "node scripts/generate_stripe_test_data_v1.mjs",
    "seed:stripe-test:dry": "node scripts/generate_stripe_test_data_v1.mjs --dry-run",
    "seed:stripe-enterprise": "node scripts/generate_stripe_test_data_enterprise_v1.mjs --mode=pm --currency=all",
    "seed:stripe-enterprise:dry": "node scripts/generate_stripe_test_data_enterprise_v1.mjs --dry-run --mode=pm --currency=all",
    "seed:stripe-enterprise:quick": "node scripts/generate_stripe_test_data_enterprise_v1.mjs --mode=pm --currency=usd --quick",
    "seed:founder-july": "node scripts/generate_founder_july_csv_v1.mjs",
    "convert:payments": "tsx scripts/convert_payments_csv_v1.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@neondatabase/serverless": "^1.1.0",
    "@polar-sh/sdk": "^0.47.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.12.0",
    "next": "^16.3.1",
    "next-intl": "^4.13.5",
    "papaparse": "^5.5.3",
    "react": "^18",
    "react-dom": "^18",
    "react-dropzone": "^15.0.0",
    "recharts": "^3.8.1",
    "resend": "^6.20.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8.5.26",
    "shadcn": "^4.6.0",
    "stripe": "^18.5.0",
    "tailwindcss": "^4.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
