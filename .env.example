# Copy to .env.local for local development.
# Production: set the same variables in Vercel -> Project -> Settings -> Environment Variables.

# Required for local upload / checkout (min 32 characters)
# Generate: openssl rand -base64 32
CHECKOUT_TOKEN_ENCRYPTION_KEY=
REPORT_TOKEN_SALT=

DATABASE_URL=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional. GA4 helps with behavior analytics; Google Search Console remains the source for queries/CTR.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_PRO=
POLAR_PRODUCT_MONITOR_MONTHLY=
POLAR_SERVER=sandbox

RESEND_API_KEY=
EMAIL_FROM=Fee Auditor <noreply@feeauditor.com>
EMAIL_REPLY_TO=

CRON_SECRET=
NEWSLETTER_UNSUBSCRIBE_SECRET=
BILLING_PORTAL_SECRET=
FULL_REPORTS_FREE_DURING_BETA=false

# Trust generic proxy IP headers only when self-hosting behind a proxy you control.
# Leave disabled on Vercel; VERCEL=1 is set automatically by the platform.
TRUST_PROXY=0
